# Varlock 환경변수 스키마 — 모든 비밀값은 @sensitive 표시
# 검증: varlock load | 실행: varlock run -- docker compose up -d

@defaultSensitive=true

# === PostgreSQL ===
POSTGRES_USER=string @required
POSTGRES_PASSWORD=string @required @sensitive @minLength(12)
POSTGRES_HOST=string @default("postgres")
POSTGRES_PORT=number @default(5432)
AUTH_DB_PASSWORD=string @required @sensitive @minLength(12)
LEARN_DB_PASSWORD=string @required @sensitive @minLength(12)
COMMUNITY_DB_PASSWORD=string @required @sensitive @minLength(12)

# === Redis ===
REDIS_PASSWORD=string @required @sensitive @minLength(12)

# === JWT ===
# PEM contents never enter this file. These are absolute host paths outside the
# release tree and are mounted as read-only Compose secrets at runtime.
JWT_SECRET_KEY_SOURCE=string @required
JWT_PUBLIC_KEY_SOURCE=string @required
JWT_ALGORITHM=enum(HS256,RS256) @default("RS256")
ACCESS_TOKEN_EXPIRE_MINUTES=number @default(15)
REFRESH_TOKEN_EXPIRE_DAYS=number @default(7)

# === 최고관리자 (최초 부트스트랩용) ===
ADMIN_USERNAME=string @default("admin")
ADMIN_EMAIL=string @default("admin@ctf.example.ac.kr")
ADMIN_PASSWORD=string @sensitive @required

# === OAuth ===
GITHUB_CLIENT_ID=string
GITHUB_CLIENT_SECRET=string @sensitive
GOOGLE_CLIENT_ID=string
GOOGLE_CLIENT_SECRET=string @sensitive

# === CTFd ===
CTFD_URL=string @default("http://ctfd:8010")
CTFD_ADMIN_TOKEN=string @required @sensitive
CTFD_SECRET_KEY=string @required @sensitive

# === SMTP ===
SMTP_HOST=string @default("mailpit")
SMTP_PORT=number @default(1025)
SMTP_FROM=string @default("noreply@ctf.example.ac.kr")
SMTP_TLS=boolean @default(false)
SMTP_USER=string
SMTP_PASSWORD=string @sensitive

# === MinIO ===
MINIO_ROOT_USER=string @required
MINIO_ROOT_PASSWORD=string @required @sensitive @minLength(8)
MINIO_URL=string @default("http://minio:9000")

# === 사이트/도메인 ===
SITE_DOMAIN=string @default("localhost")
CORS_ORIGINS=string @default("[\"http://localhost:3100\"]")
INTERNAL_API_KEY=string @required @sensitive @minLength(16)

# === Discord 연동 (선택) ===
DISCORD_CLIENT_ID=string
DISCORD_CLIENT_SECRET=string @sensitive
DISCORD_BOT_TOKEN=string @sensitive
DISCORD_GUILD_ID=string
DISCORD_MEMBER_ROLE_ID=string

# === 환경 구분 ===
ENVIRONMENT=enum(development,staging,production) @default("development")

# === Sentry ===
SENTRY_DSN=string @sensitive

# === 라이브 환경 ===
CHALLENGE_PORT_MIN=number @default(10000)
CHALLENGE_PORT_MAX=number @default(60000)
CONTAINER_TTL_MINUTES=number @default(30)
CONTAINER_MAX_PER_USER=number @default(2)
CONTAINER_MAX_GLOBAL=number @default(50)
CONTAINER_READINESS_TIMEOUT_SECONDS=number @default(45)
CONTAINER_CPU_LIMIT=string @default("0.5")
CONTAINER_MEMORY_LIMIT=string @default("512m")
# Dynamic instance flags remain disabled until the operator deliberately
# provides a secret keyring. Its contents must never be logged or committed.
DYNAMIC_INSTANCE_FLAGS_ENABLED=boolean @default(false)
DYNAMIC_FLAG_HMAC_KEYRING=string @sensitive
DYNAMIC_FLAG_RUNTIME_DIR=string @default("/var/lib/ctf-web/dynamic-flags")
PORT_COOLDOWN_SECONDS=number @default(30)
RECONCILE_INTERVAL_MINUTES=number @default(5)
ALERT_WEBHOOK_URL=string

# === 프론트엔드 ===
FRONTEND_URL=string @default("http://localhost")
NEXT_PUBLIC_API_URL=string @default("")
NEXT_PUBLIC_SITE_URL=string @default("https://ctf.example.ac.kr")
NEXT_PUBLIC_SENTRY_DSN=string @sensitive
