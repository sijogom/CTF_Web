# CTF 플랫폼 Caddyfile — /ctf 서브패스 배포
# 개발은 CADDY_SITE_ADDRESS=:8080, 운영은 SITE_DOMAIN을 주소로 전달한다.
# 운영 도메인 주소는 Caddy 자동 HTTPS로 80/443을 사용한다.

{$CADDY_SITE_ADDRESS::8080} {
    # 헬스체크 엔드포인트 (올바른 Caddy v2 문법)
    handle /health {
        respond 200
    }

    # /ctf (정확히) → /ctf/ko 리다이렉트
    @ctf_root path /ctf
    redir @ctf_root /ctf/ko 301

    # === /ctf 이하 모든 요청 ===
    handle /ctf/* {

        # === 내부 API 차단 ===
        handle /ctf/internal/* {
            respond 403
        }

        # === 보안: 내부 인증 헤더 스푸핑 방지 ===
        request_header -X-User-ID
        request_header -X-User-Role
        request_header -X-User-Name

        # === 인증 서비스 ===
        handle /ctf/api/auth/* {
            @auth_internal path /ctf/api/auth/internal /ctf/api/auth/internal/*
            respond @auth_internal 403
            uri strip_prefix /ctf/api/auth
            reverse_proxy {$AUTH_HOST:localhost}:{$AUTH_PORT:8020}
        }

        # === CTF 문제 상세/첨부파일 (learn-service에서 관리) ===
        # 대회 메타데이터 API와 같은 /competitions 접두사를 쓰지만, 이 두 경로는
        # Learn의 대회 접근 검증 후 문제 설명·힌트·첨부파일을 반환한다. Auth 대회
        # 메타데이터 catch-all보다 먼저 매칭하지 않으면 정상 참가자도 404를 받는다.
        @learn_competition_challenge path_regexp learn_competition_challenge ^/ctf/api/learn/competitions/[^/]+/challenges/[0-9]+(?:/files/[0-9]+)?$
        handle @learn_competition_challenge {
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/learn
            reverse_proxy {$LEARN_HOST:localhost}:{$LEARN_PORT:8100}
        }

        # === 대회 메타데이터 API (auth-service에서 관리 — /api/learn/* 보다 먼저 매칭) ===
        handle /ctf/api/learn/competitions/* {
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/learn
            reverse_proxy {$AUTH_HOST:localhost}:{$AUTH_PORT:8020}
        }
        handle /ctf/api/learn/competitions {
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/learn
            reverse_proxy {$AUTH_HOST:localhost}:{$AUTH_PORT:8020}
        }

        # === 학습 서비스 ===
        # Education attachments allow a 250 MiB file. Limit only these two
        # multipart routes before FastAPI parses the request; the 256 MiB body
        # ceiling leaves a multipart envelope while the API enforces 250 MiB.
        @education_asset_upload {
            method POST
            path_regexp education_asset_upload_path ^/ctf/api/learn/education/(?:classes|assignments)/[^/]+/assets$
        }
        handle @education_asset_upload {
            request_body {
                max_size 268435456
            }
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/learn
            reverse_proxy {$LEARN_HOST:localhost}:{$LEARN_PORT:8100}
        }

        handle /ctf/api/learn/* {
            @learn_internal path /ctf/api/learn/internal /ctf/api/learn/internal/*
            respond @learn_internal 403
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/learn
            reverse_proxy {$LEARN_HOST:localhost}:{$LEARN_PORT:8100}
        }

        # === 팀 API (auth-service에서 관리) ===
        handle /ctf/api/community/teams {
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/community
            reverse_proxy {$AUTH_HOST:localhost}:{$AUTH_PORT:8020}
        }
        handle /ctf/api/community/teams/* {
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/community
            reverse_proxy {$AUTH_HOST:localhost}:{$AUTH_PORT:8020}
        }

        # === 커뮤니티 서비스 ===
        handle /ctf/api/community/* {
            @community_internal path /ctf/api/community/internal /ctf/api/community/internal/*
            respond @community_internal 403
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/community
            reverse_proxy {$COMMUNITY_HOST:localhost}:{$COMMUNITY_PORT:8300}
        }

        # === CTF 대회 API (auth-service에서 관리) ===
        handle /ctf/api/ctf/* {
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/ctf
            reverse_proxy {$AUTH_HOST:localhost}:{$AUTH_PORT:8020}
        }

        # === 실습 환경 API ===
        handle /ctf/api/env/* {
            forward_auth {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                uri /verify-token
                copy_headers X-User-ID X-User-Role X-User-Name
            }
            uri strip_prefix /ctf/api/env
            reverse_proxy {$ENV_ORCH_HOST:localhost}:{$ENV_ORCH_PORT:8200}
        }

        # === 실습 환경 HTTP 프록시 ===
        handle /ctf/env/proxy/* {
            uri strip_prefix /ctf
            reverse_proxy {$ENV_ORCH_HOST:localhost}:{$ENV_ORCH_PORT:8200} {
                flush_interval -1
            }
        }

        # === WebSocket: 터미널 ===
        handle /ctf/ws/terminal/* {
            uri strip_prefix /ctf
            reverse_proxy {$ENV_ORCH_HOST:localhost}:{$ENV_ORCH_PORT:8200} {
                flush_interval -1
            }
        }

        # === WebSocket: VNC ===
        handle /ctf/ws/vnc/* {
            uri strip_prefix /ctf
            reverse_proxy {$ENV_ORCH_HOST:localhost}:{$ENV_ORCH_PORT:8200} {
                flush_interval -1
            }
        }

        # === WebSocket: 스코어보드 ===
        handle /ctf/ws/scoreboard/* {
            uri strip_prefix /ctf
            reverse_proxy {$AUTH_HOST:localhost}:{$AUTH_PORT:8020} {
                flush_interval -1
            }
        }

        # === MinIO 스토리지 프록시 ===
        # `route`는 아래 handler의 literal order를 고정한다. 교육 자료는 비공개이며
        # 권한을 확인하는 Learn API로만 전달한다. 일반 MinIO proxy보다 먼저 처리해
        # bucket policy가 있어도 공개 Caddy 경로로 노출되지 않게 한다.
        # `route`는 Caddy directive 정렬에서 무조건 매칭되는 프런트엔드
        # `handle` 뒤로 이동할 수 있다. 그러면 storage 요청이 Next.js로
        # 흘러 500이 된다. 경로 matcher를 가진 handle을 직접 사용해
        # /ctf/storage/*가 프런트엔드 fallback보다 먼저 선택되게 한다.
        handle /ctf/storage/* {
            @education_private_storage path_regexp education_private_storage ^/ctf/storage/education-private-assets(?:/|$)
            handle @education_private_storage {
                respond 404
            }

            handle {
                uri strip_prefix /ctf/storage
                reverse_proxy {$MINIO_HOST:127.0.0.1}:9000
            }
        }

        # === 프론트엔드 (나머지 — Next.js basePath: /ctf) ===
        handle {
            reverse_proxy {$FRONTEND_HOST:localhost}:{$FRONTEND_PORT:3100} {
                header_up Host localhost:{$FRONTEND_PORT:3100}
            }
        }

        # === 보안 헤더 ===
        header {
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Referrer-Policy strict-origin-when-cross-origin
            Permissions-Policy "camera=(), microphone=(), geolocation=()"
            -Server
        }
    }

    # /ctf 이외 경로는 차단
    handle {
        respond "Not Found" 404
    }

    log {
        output stdout
        format json
    }
}

# 운영 공개 리스너와 분리한 컨테이너 내부 헬스체크용 HTTP 리스너.
# host network에서도 loopback에만 바인딩한다.
http://127.0.0.1:2010 {
    handle /health {
        respond 200
    }

    handle {
        respond "Not Found" 404
    }
}
