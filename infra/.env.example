# ═══════════════════════════════════════════════════════════
# CTF 학습 플랫폼 — 중앙 환경변수 템플릿
# 사용법: 이 파일을 .env로 복사한 뒤 값을 수정
#   cp .env.example .env
# ⚠ 운영 환경에서는 반드시 모든 비밀번호를 변경하세요!
# ═══════════════════════════════════════════════════════════

# ──── 환경 ────
ENVIRONMENT=development          # development | production
SITE_DOMAIN=YOUR_DOMAIN          # 예: example.com
FRONTEND_URL=http://localhost:3100

# ──── PostgreSQL ────
POSTGRES_USER=ctfplatform
POSTGRES_PASSWORD=CHANGE_ME_postgres
AUTH_DB_PASSWORD=CHANGE_ME_auth
LEARN_DB_PASSWORD=CHANGE_ME_learn
COMMUNITY_DB_PASSWORD=CHANGE_ME_community

# ──── Redis ────
REDIS_PASSWORD=CHANGE_ME_redis

# ──── MinIO (파일 스토리지) ────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false

# ──── JWT (RS256 비대칭 키) ────
# PEM은 release/source/image에 두거나 환경변수 본문으로 전달하지 않는다.
# Linux 운영 서버의 release 밖 private directory(예: /etc/ctf-web/secrets)에
# 0600 private key와 0644 public key를 준비하고, 아래에는 절대 경로만 적는다.
# 키 생성은 승인된 Linux 운영 절차에서만 수행한다.
JWT_ALGORITHM=RS256
JWT_SECRET_KEY_SOURCE=/etc/ctf-web/secrets/jwt_private.pem
JWT_PUBLIC_KEY_SOURCE=/etc/ctf-web/secrets/jwt_public.pem

# ──── 관리자 초기 계정 ────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-domain.ac.kr
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ──── SMTP ────
# 개발: Mailpit (SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_TLS=false)
# 프로덕션 (Gmail): 2FA 활성화 후 앱 비밀번호 발급 필요
#   Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호 → "메일" 선택
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@your-domain.ac.kr
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# ──── 프론트엔드 ────
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
FRONTEND_HOST=localhost          # 프로덕션: localhost (host 모드) | 개발: WSL2 게이트웨이 IP (server.sh가 자동 설정)

# ──── 내부 서비스 간 통신 키 ────
# 서비스 간 /internal/* API 호출 시 X-Internal-Key 헤더로 검증
INTERNAL_API_KEY=CHANGE_ME_internal_api_key

# ──── Discord OAuth + Bot ────
# Discord 개발자 포털에서 Application 생성 후 입력
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=

# ──── CTFd (사용 시) ────
CTFD_URL=http://localhost:8010
CTFD_ADMIN_TOKEN=
CTFD_SECRET_KEY=CHANGE_ME_ctfd_secret
